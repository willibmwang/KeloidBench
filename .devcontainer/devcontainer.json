{
  "name": "KeloidBench demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r demo/requirements.txt",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "KeloidBench interactive demo",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}
